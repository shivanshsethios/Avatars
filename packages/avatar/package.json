{
  "name": "@shivanshos/avatar",
  "version": "0.0.1",
  "description": "Avatar generation and URL management for ShivansOS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesOptional": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "keywords": ["avatar", "gravatar", "identicon", "profile-picture"]
}
